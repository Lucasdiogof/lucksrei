# Cabeçalhos dos arquivos estáticos (o Worker só atende /api/*; lá os cabeçalhos ficam em worker/security.mjs).
# Cada linha tem no máximo 2000 caracteres (limite do Cloudflare). Ver docs/security.md para o que cada um faz e como reverter.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), display-capture=(), accelerometer=(), gyroscope=(), magnetometer=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=2592000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'sha256-fO/nXrBX2E+6Q1alMozl4bt1yQoQb2tAXejEoVcCavM=' 'sha256-KkQE/uOv9nCsOLhOobVyTzKrugO3NVSSNDbNJPZlnuw='; style-src-attr 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

/.well-known/apple-app-site-association
  Content-Type: application/json

# Vídeos de vitrine (um arquivo por idioma e codec): cache de 1 ano e imutável, seguro porque as URLs levam ?v=<VER> (VER em assets/js/loop-video.js,
# espelhado nos <noscript> das páginas) e o HTML/JS são sempre revalidados. Ao re-renderizar QUALQUER vídeo ou pôster, suba VER (e os ?v= dos <noscript>):
# a URL nova ignora o cache antigo. O Range (206) vem do Worker (worker/range.mjs). Ver tools/video-i18n/RELATORIO-ETAPA3.md.
/assets/video/*
  Cache-Control: public, max-age=31536000, immutable
